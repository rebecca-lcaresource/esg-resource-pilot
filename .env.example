# Copy this file to .env.local and fill in the values from the Supabase dashboard
# (Project Settings -> API). .env.local is gitignored and must never be committed.
#
# The anon / publishable key is browser-safe. The service_role key is NOT — it is
# only used by the Netlify scheduled digest function and is set in Netlify env vars,
# never here and never in any committed file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
